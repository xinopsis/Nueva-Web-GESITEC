# Grupo GESITEC — sitio estático (Next.js export) + API PHP en /api/
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# Forzar HTTPS y dominio sin www. ACTIVAR (quitar los #) cuando el certificado SSL
# esté instalado; si se activa antes, el sitio deja de cargar.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on [OR]
#   RewriteCond %{HTTP_HOST} ^www\. [NC]
#   RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
#   RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# </IfModule>

# Nueva estructura: las unidades estratégicas ya no cuelgan de /technology
# y Caligo tiene su propia web. Redirecciones permanentes de las URLs antiguas.
<IfModule mod_alias.c>
  RedirectMatch 301 ^/technology/(advisory|security|innova)(/.*)?$ /$1$2
  RedirectMatch 301 ^/caligo(/.*)?$ https://caligo.pe
  RedirectMatch 301 ^/clientes/?$ /#clientes
  # Web anterior: blog en .html y páginas de unidad con extensión
  RedirectMatch 301 ^/blog\.html$ /blog/
  RedirectMatch 301 ^/blog/([a-z0-9-]+)\.html$ /blog/$1/
  RedirectMatch 301 ^/(advisory|technology|security|innova)\.html$ /$1/
  RedirectMatch 301 ^/index\.htm$ /
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Archivos con hash de Next.js: caché de 1 año
  <If "%{REQUEST_URI} =~ m#^/video/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

AddType text/plain .txt
AddType font/woff2 .woff2
AddType video/mp4 .mp4
